# 배포 도메인(origin). GitHub Pages 배포 시 워크플로가 자동으로 넣어줍니다.
NEXT_PUBLIC_SITE_URL=https://theshy3819.github.io

# 사이트 하위 경로. GitHub Pages(/MAISON_DE_L) 배포 시 워크플로가 자동으로 넣어줍니다. 로컬에서는 비워두세요.
NEXT_PUBLIC_BASE_PATH=

# 상담 신청 폼을 받을 주소 (Formspree, Google Apps Script 웹앱 등). 비우면 방문자의 메일 앱으로 신청 메일이 작성됩니다.
# GitHub 저장소 Settings > Secrets and variables > Actions > Variables 에 RESERVATION_ENDPOINT 로 넣으면 배포에 반영됩니다.
NEXT_PUBLIC_RESERVATION_ENDPOINT=
